{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		},
		"includes": ["./src/**/*", "!tailwind.config.js", "!src/test/**/*Error*/*", "!src/test/**/*SyntaxError*/*"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 120,
		"includes": ["./src/**/*", "!tailwind.config.js", "!src/test/fixtures/*"]
	}
}
